# --- LLM ---
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini

# --- Execution mode ---
# true = fully local simulation (no chain, no keys needed)
# false = send real transactions via RPC
MOCK_MODE=true

# --- Chain ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# --- Agent signing key (ONLY use a throwaway testnet key here) ---
AGENT_PRIVATE_KEY=0x...
AGENT_ADDRESS=0x...

# --- Deployed contracts ---
ACL_ADDRESS=
ATTESTATION_ADDRESS=
WALLET_ADDRESS=
ORACLE_ADDRESS=
CCIP_ADDRESS=

# --- Risk policy ---
# Per-tx ceiling the agent may execute without human approval (in ETH)
MAX_AUTO_TRANSFER_ETH=0.01
