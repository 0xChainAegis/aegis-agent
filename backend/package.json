{
  "name": "@aegis/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts && npm run test:vitest",
    "test:vitest": "vitest run test/ccip.spec.ts test/ccip-delivery.spec.ts test/ccip-reconciler.spec.ts test/readiness-cache.spec.ts test/rpc-concurrency.spec.ts test/sepolia-check.spec.ts test/sepolia-policy-check.spec.ts test/sepolia-policy-write.spec.ts test/sepolia-approval-check.spec.ts",
    "check:sepolia": "node --env-file=../contracts/.env --import tsx src/check-sepolia.ts",
    "test:sepolia:policy": "node --env-file=../contracts/.env --import tsx src/check-sepolia-policy.ts",
    "test:sepolia:ccip": "node --env-file=../contracts/.env --import tsx src/check-sepolia-ccip.ts",
    "verify:sepolia:approval": "node --env-file=../contracts/.env --import tsx src/check-sepolia-approval.ts"
  },
  "dependencies": { "@aegis/shared": "file:../packages/shared", "viem": "^2.38.0", "zod": "^4.1.0" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.0", "tsx": "^4.20.0", "vitest": "^5.0.5" }
}
