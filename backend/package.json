{
  "name": "@aegis/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:vitest": "vitest run --config vitest.config.ts",
    "check:sepolia": "node --env-file-if-exists=../.env --import tsx src/check-sepolia.ts"
  },
  "dependencies": { "@aegis/shared": "file:../packages/shared", "viem": "^2.38.0", "zod": "^4.1.0" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.0", "tsx": "^4.20.0", "vitest": "^3.2.7" }
}
