# Sepolia only. Never use a Hardhat/Anvil development key or commit this file.
PRIVATE_KEY=your_wallet_private_key

# HTTPS Sepolia RPC endpoint
RPC_URL=https://ethereum-sepolia.publicnode.com

# Three distinct identities: owner comes from PRIVATE_KEY.
AGENT_ADDRESS=0x_your_agent_address
RECIPIENT_ADDRESS=0x_your_allowed_recipient

# Verify this address against the official Chainlink deployment list before use.
ETH_USD_FEED_ADDRESS=0x694AA1769357215DE4FAC081bf1f309aDC325306

# Policy values use USD with 6 decimals (10 USD = 10000000).
AUTO_LIMIT_USD6=10000000
PER_TX_LIMIT_USD6=50000000
DAILY_LIMIT_USD6=100000000
MAX_PRICE_AGE=3600

# Initial native ETH deposited into AegisWallet (0.01 ETH shown).
VAULT_FUNDING_WEI=10000000000000000
DEPLOY_CONFIRMATIONS=2
