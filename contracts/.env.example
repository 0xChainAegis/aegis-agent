# Sepolia only. Never use a Hardhat/Anvil development key or commit this file.
PRIVATE_KEY=your_deployer_wallet_private_key

# HTTPS Sepolia RPC endpoint
RPC_URL=https://ethereum-sepolia.publicnode.com

# Optional public final Owner address. If omitted, PRIVATE_KEY's deployer remains Owner.
# Do not set this to an empty value; use a valid wallet address when handing off.
# OWNER_ADDRESS=0x_your_final_owner_address

# Owner, restricted executor and recipient must be distinct. The deployer must
# also be distinct from the executor and recipient. Use and fund a separate
# restricted executor for each Owner's pool; never use an Owner key in the backend.
AGENT_ADDRESS=0x_your_agent_address
RECIPIENT_ADDRESS=0x_your_allowed_recipient

# Verify this address against the official Chainlink deployment list before use.
ETH_USD_FEED_ADDRESS=0x694AA1769357215DE4FAC081bf1f309aDC325306

# Policy values use USD with 6 decimals (10 USD = 10000000).
AUTO_LIMIT_USD6=10000000
PER_TX_LIMIT_USD6=50000000
DAILY_LIMIT_USD6=100000000
MAX_PRICE_AGE=3600

# Initial native ETH deposited into AegisWallet (0.01 ETH shown).
VAULT_FUNDING_WEI=10000000000000000
DEPLOY_CONFIRMATIONS=2

# Optional real CCIP test lane: Ethereum Sepolia -> Base Sepolia, CCIP-BnM.
# Keep disabled for the ordinary native-only deployment. Enabling it deploys
# AegisCCIPSender plus an Owner-maintained TESTNET valuation feed, deposits the
# requested CCIP-BnM, and deposits Sepolia ETH for Router fees.
CCIP_ENABLED=0
# Required only when CCIP_ENABLED=1. Example: 0.1 CCIP-BnM and 0.02 Sepolia ETH.
# Obtain CCIP-BnM from the official Chainlink test-token faucet first.
# CCIP_TOKEN_FUNDING_WEI=100000000000000000
# CCIP_FEE_FUNDING_WEI=20000000000000000
# Test-only valuation with 8 decimals. 100000000 means 1 CCIP-BnM = test $1.
# This is not a live Chainlink market Data Feed.
# CCIP_TEST_TOKEN_PRICE_USD8=100000000
